# Copy to .env and fill in. .env is gitignored.

# --- Stage 1: data (London Strategic Edge) -------------------------------
# Free key: https://londonstrategicedge.com/data
LSE_API_KEY=

# --- Stage 2: validate ---------------------------------------------------
# TradingView MCP uses OAuth 2.1, NOT an API key. There is nothing to put here.
# Authorise once with:  python run.py --auth-tradingview   (phase 2)
# Optional fallback validator:
FINNHUB_API_KEY=

# --- Stage 6: debate (Anthropic) ----------------------------------------
ANTHROPIC_API_KEY=

# SEC EDGAR (extract stage). Your name and e-mail — SEC requires a contact in the
# User-Agent of every request. It is sent only to sec.gov.
SEC_USER_AGENT=
