# ---------------------------------------------------------------------------
# הגדרות כלליות  /  General settings
# ---------------------------------------------------------------------------
PORT=3000
# מפתח לחתימת העוגייה של ההתחברות. חובה לשנות!  /  Session signing secret.
SESSION_SECRET=change-me-to-a-long-random-string

# הסיסמה שלך לאתר. נשמרת כ-hash אחרי ההרצה הראשונה של `npm run set-password`.
# Your password for the site. Set it with: npm run set-password
APP_PASSWORD_HASH=

# מטבע ברירת מחדל / Default currency (ILS, USD, EUR, GBP...)
DEFAULT_CURRENCY=ILS
# אזור זמן לחישוב חודשים / Timezone used to bucket months
TIMEZONE=Asia/Jerusalem

# ---------------------------------------------------------------------------
# חיבור לתיבת הדואר / Mailbox connection
# MAIL_PROVIDER=gmail  -> Gmail API + OAuth (מומלץ / recommended)
# MAIL_PROVIDER=imap   -> IMAP + סיסמת אפליקציה / app password (הכי פשוט)
# ---------------------------------------------------------------------------
MAIL_PROVIDER=gmail

# --- Gmail API (OAuth) ---
# צור פרויקט ב-Google Cloud, הפעל את Gmail API, וצור OAuth Client מסוג "Web".
# Redirect URI: http://localhost:3000/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# --- IMAP ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# ב-Gmail זו סיסמת אפליקציה (App Password), לא סיסמת החשבון הרגילה.
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# ---------------------------------------------------------------------------
# סריקה / Scanning
# ---------------------------------------------------------------------------
# כמה ימים אחורה לסרוק בסנכרון הראשון / How many days back on first sync
INITIAL_SYNC_DAYS=180
# סנכרון אוטומטי כל X דקות (0 = כבוי) / Auto-sync every X minutes (0 = off)
SYNC_INTERVAL_MINUTES=30
